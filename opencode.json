{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "azure": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "azure",
      "options": {
        "baseURL": "{env:AZURE_API_BASE}/openai/deployments/{env:AZURE_OPENAI_DEPLOYMENT}",
        "queryParams": { "api-version": "{env:AZURE_API_VERSION}" },
        "headers": { "api-key": "{env:AZURE_API_KEY}" }
      },
      "models": {
        "gpt-5.4": { "name": "gpt-5.4" },
        "gpt-5.4-pro": { "name": "gpt-5.4-pro" },
        "gpt-5.3-codex": { "name": "gpt-5.3-codex" },
        "gpt-5.3-chat": { "name": "gpt-5.3-chat" }
      }
    }
  },
  "model": "azure/{env:AZURE_OPENAI_DEPLOYMENT}"
}
